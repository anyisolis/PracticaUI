<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PracticaUI.NewPage1"
             Title="ConversorMoneda">
    
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center"> 
        <Label Text="Conversor de Monedas" FontSize="22" FontAttributes="Bold"/>
        <Entry x:Name="txtMonto" FontSize="15" Placeholder="Monto a convertir" Keyboard="Numeric"/>

        <Label Text="Moneda de Origen: "/>
        <Picker x:Name="pckOrigen" Title="Seleccione Origen">
            <Picker.Items>
                <x:String>HNL (Lempiras)</x:String>
                <x:String>USD (Dolares)</x:String>
                <x:String>EUR (Euros)</x:String>
            </Picker.Items>
            </Picker>

        <Label Text="Moneda Destino: "/>
        <Picker x:Name="pckDetino" Title="Seleccione Destino">
            <Picker.Items>
                <x:String>HNL (Lempiras)</x:String>
                <x:String>USD (Dolares)</x:String>
                <x:String>EUR (Euros)</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Convertir" Clicked="onConvertirClicked"
                BackgroundColor="#0D9488" TextColor="White"/>

        <Label x:Name="lblResultado" FontSize="20" FontAttributes="Bold"
               HorizontalOptions="Center" Margin="0, 15, 0, 0"/>

    </VerticalStackLayout>
    
</ContentPage>